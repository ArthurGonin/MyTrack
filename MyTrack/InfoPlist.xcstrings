{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MyTrack"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack verwendet die Kamera, um Ihr Fahrzeug zu fotografieren und es auf dem Startbildschirm anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack uses the camera to photograph your vehicle and show it on the home screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa la cámara para fotografiar su vehículo y mostrarlo en la pantalla de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack utilise l'appareil photo pour prendre votre véhicule en photo et l'afficher sur l'écran d'accueil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa la fotocamera per fotografare il suo veicolo e mostrarlo nella schermata principale."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa a câmara para fotografar o seu veículo e mostrá-lo no ecrã principal."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack verwendet Ihren Standort – auch im Hintergrund –, um Ihre Autofahrten automatisch zu erkennen und aufzuzeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack uses your location, including in the background, to detect and record your car trips automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa su ubicación, incluso en segundo plano, para detectar y registrar sus viajes en coche automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack utilise votre position, y compris en arrière-plan, pour détecter et enregistrer automatiquement vos trajets en voiture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa la sua posizione, anche in background, per rilevare e registrare automaticamente i suoi viaggi in auto."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa a sua localização, incluindo em segundo plano, para detetar e registar automaticamente as suas viagens de carro."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack verwendet Ihren Standort, um Strecke und Distanz Ihrer Fahrten aufzuzeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack uses your location to record the route and distance of your trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa su ubicación para registrar el recorrido y la distancia de sus viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack utilise votre position pour enregistrer le tracé et la distance de vos trajets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa la sua posizione per registrare il percorso e la distanza dei suoi viaggi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa a sua localização para registar o percurso e a distância das suas viagens."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack verwendet Bewegungsdaten, um Anfang und Ende Ihrer Autofahrten automatisch zu erkennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack uses motion data to detect the start and end of your car trips automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa los datos de movimiento para detectar automáticamente el inicio y el final de sus viajes en coche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack utilise les données de mouvement pour détecter automatiquement le début et la fin de vos trajets en voiture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa i dati di movimento per rilevare automaticamente l'inizio e la fine dei suoi viaggi in auto."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack usa os dados de movimento para detetar automaticamente o início e o fim das suas viagens de carro."
          }
        }
      }
    }
  },
  "version" : "1.0"
}