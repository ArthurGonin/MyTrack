    "Supprime définitivement tous vos trajets, véhicules et réglages. Cette action est irréversible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alle Ihre Fahrten, Fahrzeuge und Einstellungen endgültig. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently deletes all your trips, vehicles and settings. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente todos sus viajes, vehículos y ajustes. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement tous vos trajets, véhicules et réglages. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente tutti i suoi viaggi, veicoli e impostazioni. L'operazione è irreversibile."
