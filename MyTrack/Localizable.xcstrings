    "Inactif : l'enregistrement de nouveaux trajets nécessite un abonnement actif." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktiv: Das Aufzeichnen neuer Fahrten setzt ein aktives Abo voraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactive: recording new trips requires an active subscription."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactivo: registrar nuevos viajes requiere una suscripción activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactif : l'enregistrement de nouveaux trajets nécessite un abonnement actif."
          }
        },
        "it" : {
