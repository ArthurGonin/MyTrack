    "MyTrack" : {

    },
    "MyTrack peut détecter et enregistrer vos trajets en voiture automatiquement, sans que vous ayez à y penser." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack kann Ihre Autofahrten automatisch erkennen und aufzeichnen, ganz ohne Ihr Zutun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack can detect and record your car trips automatically, without you having to think about it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack puede detectar y registrar sus viajes en coche automáticamente, sin que tenga que pensar en ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack peut détecter et enregistrer vos trajets en voiture automatiquement, sans que vous ayez à y penser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack può rilevare e registrare i suoi viaggi in auto automaticamente, senza che debba pensarci."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack pode detetar e registar as suas viagens de carro automaticamente, sem que tenha de pensar nisso."
          }
        }
      }
    },
    "MyTrack vous demande de confirmer chaque trajet détecté avant de l'enregistrer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack bittet Sie, jede erkannte Fahrt zu bestätigen, bevor sie gespeichert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack asks you to confirm each detected trip before saving it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack le pide que confirme cada viaje detectado antes de guardarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack vous demande de confirmer chaque trajet détecté avant de l'enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack le chiede di confermare ogni viaggio rilevato prima di salvarlo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MyTrack pede-lhe para confirmar cada viagem detetada antes de a guardar."
          }
        }
      }
