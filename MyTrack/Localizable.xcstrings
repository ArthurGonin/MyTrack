    "Sans abonnement actif, aucun nouveau trajet n'est enregistré. Tes trajets et rapports déjà enregistrés restent accessibles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne aktives Abo werden keine neuen Fahrten aufgezeichnet. Bereits gespeicherte Fahrten und Berichte bleiben verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without an active subscription, no new trips are recorded. The trips and reports you've already saved remain available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin una suscripción activa no se registra ningún viaje nuevo. Los viajes e informes ya guardados siguen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans abonnement actif, aucun nouveau trajet n'est enregistré. Tes trajets et rapports déjà enregistrés restent accessibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza un abbonamento attivo non viene registrato alcun nuovo viaggio. I viaggi e i rapporti già salvati restano accessibili."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem uma subscrição ativa, não é registada nenhuma viagem nova. As viagens e relatórios já guardados continuam acessíveis."
          }
        }
      }
    },
