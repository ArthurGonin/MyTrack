    "Inactif : le suivi automatique a besoin de l'accès à la position réglé sur « Toujours » pour que l'app soit réveillée au début d'un trajet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktiv: Die automatische Erfassung braucht den Standortzugriff „Immer“, damit die App zu Beginn einer Fahrt aktiviert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactive: automatic tracking needs location access set to “Always” so the app can be woken when a trip starts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactivo: el seguimiento automático necesita el acceso a la ubicación en «Siempre» para que la app se active al empezar un viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactif : le suivi automatique a besoin de l'accès à la position réglé sur « Toujours » pour que l'app soit réveillée au début d'un trajet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non attivo: il rilevamento automatico richiede l'accesso alla posizione impostato su “Sempre” perché l'app venga riattivata all'inizio di un viaggio."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inativo: a deteção automática precisa do acesso à localização definido como «Sempre» para que a app seja ativada no início de uma viagem."
          }
        }
      }
    },
    "Inactif : le suivi automatique a besoin de l'accès à Motion et forme pour reconnaître la conduite." : {
