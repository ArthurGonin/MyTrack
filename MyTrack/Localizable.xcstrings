    "Elle sera détourée, puis posée sur votre écran d'accueil." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird freigestellt und dann auf Ihren Startbildschirm gesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gets cut out, then placed on your home screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se recortará y luego se colocará en su pantalla de inicio."
          }
        },
        "fr" : {
