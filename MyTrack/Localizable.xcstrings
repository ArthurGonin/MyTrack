    "Réglez l'accès à la position sur « Toujours » dans Réglages pour activer le suivi automatique." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie den Standortzugriff in den Einstellungen auf „Immer“, um die automatische Erfassung zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set location access to “Always” in Settings to turn on automatic tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure el acceso a la ubicación en «Siempre» en Ajustes para activar el seguimiento automático."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez l'accès à la position sur « Toujours » dans Réglages pour activer le suivi automatique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposti l'accesso alla posizione su “Sempre” in Impostazioni per attivare il rilevamento automatico."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina o acesso à localização como «Sempre» nas Definições para ativar a deteção automática."
          }
        }
      }
    },
    "Réglez la position sur « Toujours » et autorisez l'activité physique dans Réglages pour activer le suivi automatique." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie den Standort auf „Immer“ und erlauben Sie die körperliche Aktivität in den Einstellungen, um die automatische Erfassung zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set location to “Always” and allow physical activity in Settings to turn on automatic tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure la ubicación en «Siempre» y permita la actividad física en Ajustes para activar el seguimiento automático."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez la position sur « Toujours » et autorisez l'activité physique dans Réglages pour activer le suivi automatique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposti la posizione su “Sempre” e consenta l'attività fisica in Impostazioni per attivare il rilevamento automatico."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina a localização como «Sempre» e permita a atividade física nas Definições para ativar a deteção automática."
          }
        }
      }
    },
    "Renouvellement automatique, résiliable à tout moment depuis ton compte App Store. Sans résiliation au moins 24 h avant la fin de l'essai, l'abonnement devient payant." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch, jederzeit über dein App-Store-Konto kündbar. Wird nicht mindestens 24 Stunden vor Ende der Testphase gekündigt, wird das Abo kostenpflichtig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renews automatically; cancel any time from your App Store account. Unless you cancel at least 24 hours before the trial ends, the subscription becomes paid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente y puedes cancelarla en cualquier momento desde tu cuenta de App Store. Si no la cancelas al menos 24 horas antes de que termine la prueba, la suscripción pasa a ser de pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique, résiliable à tout moment depuis ton compte App Store. Sans résiliation au moins 24 h avant la fin de l'essai, l'abonnement devient payant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente e puoi disdirlo in qualsiasi momento dal tuo account App Store. Se non disdici almeno 24 ore prima della fine della prova, l'abbonamento diventa a pagamento."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova-se automaticamente e podes cancelar a qualquer momento na tua conta App Store. Se não cancelares pelo menos 24 horas antes do fim do período experimental, a subscrição passa a ser paga."
          }
        }
      }
    },
    "Renouvellement automatique, résiliable à tout moment depuis votre compte App Store." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch, jederzeit über Ihr App-Store-Konto kündbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renews automatically; cancel any time from your App Store account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente y puede cancelarla en cualquier momento desde su cuenta de App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique, résiliable à tout moment depuis votre compte App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente e può disdirlo in qualsiasi momento dal suo account App Store."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova-se automaticamente e pode cancelar a qualquer momento na sua conta App Store."
          }
        }
      }
