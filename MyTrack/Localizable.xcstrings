    "Quand MyTrack détecte un trajet, veux-tu le confirmer avant qu'il soit enregistré, ou préfères-tu qu'il soit accepté automatiquement ?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn MyTrack eine Fahrt erkennt, möchtest du sie bestätigen, bevor sie gespeichert wird, oder soll sie automatisch übernommen werden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When MyTrack detects a trip, do you want to confirm it before it's saved, or would you rather it be accepted automatically?"
          }
