        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand MyTrack détecte un trajet, voulez-vous le confirmer avant qu'il soit enregistré, ou préférez-vous qu'il soit accepté automatiquement ?"
