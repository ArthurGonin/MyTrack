    "Tous vos trajets, véhicules, rapports et réglages seront définitivement supprimés. Cette action est irréversible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Ihre Fahrten, Fahrzeuge, Berichte und Einstellungen werden endgültig gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your trips, vehicles, reports and settings will be permanently deleted. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos sus viajes, vehículos, informes y ajustes se eliminarán definitivamente. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous vos trajets, véhicules, rapports et réglages seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i suoi viaggi, veicoli, rapporti e impostazioni saranno eliminati definitivamente. L'operazione è irreversibile."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as suas viagens, veículos, relatórios e definições serão eliminados definitivamente. Esta ação é irreversível."
          }
        }
      }
    },
