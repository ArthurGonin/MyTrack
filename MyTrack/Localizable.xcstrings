    "Elle se lance toute seule quand je prends la voiture. J'ai fini par l'oublier — c'est le plus beau compliment." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie startet von allein, sobald ich ins Auto steige. Ich habe sie irgendwann vergessen — das schönste Kompliment."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It starts on its own whenever I get in the car. I ended up forgetting about it — which is the best compliment I can give it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pone en marcha sola cuando cojo el coche. He acabado olvidándome de ella, y es el mejor cumplido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle se lance toute seule quand je prends la voiture. J'ai fini par l'oublier — c'est le plus beau compliment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si avvia da sola quando prendo la macchina. Ho finito per dimenticarmene — ed è il complimento più bello."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arranca sozinha quando entro no carro. Acabei por me esquecer dela — e esse é o melhor elogio."
          }
        }
      }
    },
