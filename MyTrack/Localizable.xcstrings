    },
    "MyTrack peut détecter et enregistrer tes trajets en voiture automatiquement, sans que tu aies à y penser." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack kann deine Autofahrten automatisch erkennen und aufzeichnen, ganz ohne dein Zutun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack can detect and record your car trips automatically, without you having to think about it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack puede detectar y registrar tus viajes en coche automáticamente, sin que tengas que pensar en ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack peut détecter et enregistrer tes trajets en voiture automatiquement, sans que tu aies à y penser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack può rilevare e registrare i tuoi viaggi in auto automaticamente, senza che tu debba pensarci."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack pode detetar e registar as tuas viagens de carro automaticamente, sem que tenhas de pensar nisso."
          }
        }
      }
    },
    "MyTrack te demande de confirmer chaque trajet détecté avant de l'enregistrer." : {
      "localizations" : {
