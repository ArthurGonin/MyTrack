    "Vos trajets ne sont plus enregistrés. Vos trajets et rapports déjà enregistrés restent accessibles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Fahrten werden nicht mehr aufgezeichnet. Bereits gespeicherte Fahrten und Berichte bleiben verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your trips are no longer being recorded. The trips and reports you've already saved remain available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus viajes ya no se registran. Los viajes e informes ya guardados siguen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos trajets ne sont plus enregistrés. Vos trajets et rapports déjà enregistrés restent accessibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi viaggi non vengono più registrati. I viaggi e i rapporti già salvati restano accessibili."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As suas viagens já não são registadas. As viagens e relatórios já guardados continuam acessíveis."
          }
        }
      }
    },
    "Votre abonnement a été retrouvé sur ce compte App Store." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Abo wurde für dieses App-Store-Konto gefunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your subscription was found on this App Store account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos encontrado su suscripción en esta cuenta de App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre abonnement a été retrouvé sur ce compte App Store."
          }
        },
        "it" : {
          "stringUnit" : {
