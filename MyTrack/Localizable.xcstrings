    "Quand MyTrack détecte un trajet, voulez-vous le confirmer avant qu'il soit enregistré, ou préférez-vous qu'il soit accepté automatiquement ?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn MyTrack eine Fahrt erkennt, möchten Sie sie bestätigen, bevor sie gespeichert wird, oder soll sie automatisch übernommen werden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When MyTrack detects a trip, do you want to confirm it before it's saved, or would you rather it be accepted automatically?"
