    "Supprime définitivement tous tes trajets, véhicules et réglages. Cette action est irréversible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alle deine Fahrten, Fahrzeuge und Einstellungen endgültig. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently deletes all your trips, vehicles and settings. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente todos tus viajes, vehículos y ajustes. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement tous tes trajets, véhicules et réglages. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente tutti i tuoi viaggi, veicoli e impostazioni. L'operazione è irreversibile."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
