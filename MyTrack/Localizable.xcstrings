            "value" : "Changes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificaciones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifications"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiche"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterações"
          }
        }
      }
    },
    "MyTrack enregistre vos trajets sur votre iPhone, et ils y restent. L'app n'a pas de compte à créer, pas de serveur où vos trajets seraient recopiés, aucune publicité et aucun traceur." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack zeichnet Ihre Fahrten auf Ihrem iPhone auf, und dort bleiben sie. Die App verlangt kein Konto, hat keinen Server, auf den Ihre Fahrten kopiert würden, keine Werbung und keine Tracker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack records your trips on your iPhone, and that is where they stay. The app has no account to create, no server your trips are copied to, no advertising and no trackers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack registra sus trayectos en su iPhone, y ahí se quedan. La app no tiene cuenta que crear, ni servidor donde se copien sus trayectos, ni publicidad, ni rastreadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack enregistre vos trajets sur votre iPhone, et ils y restent. L'app n'a pas de compte à créer, pas de serveur où vos trajets seraient recopiés, aucune publicité et aucun traceur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack registra i tuoi viaggi sul tuo iPhone, ed è lì che restano. L'app non richiede alcun account, non ha un server su cui copiare i tuoi viaggi, nessuna pubblicità e nessun tracciatore."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MyTrack regista as suas viagens no seu iPhone, e é aí que ficam. A app não tem conta a criar, nem servidor para onde as suas viagens sejam copiadas, nem publicidade, nem rastreadores."
          }
        }
      }
    },
    "MyTrack est fournie en l'état et selon sa disponibilité. Dans les limites permises par le droit applicable, KiwiJuice ne répond pas des dommages indirects, d'une perte de données ni d'un manque à gagner résultant de l'usage de l'app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack wird wie besehen und nach Verfügbarkeit bereitgestellt. Im gesetzlich zulässigen Rahmen haftet KiwiJuice nicht für mittelbare Schäden, Datenverlust oder entgangenen Gewinn aus der Nutzung der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack is provided as is and as available. To the extent permitted by applicable law, KiwiJuice is not liable for indirect damage, loss of data or loss of profit arising from use of the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack se proporciona tal cual y según disponibilidad. Dentro de los límites permitidos por la ley aplicable, KiwiJuice no responde de daños indirectos, pérdida de datos ni lucro cesante derivados del uso de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack est fournie en l'état et selon sa disponibilité. Dans les limites permises par le droit applicable, KiwiJuice ne répond pas des dommages indirects, d'une perte de données ni d'un manque à gagner résultant de l'usage de l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack è fornita così com'è e secondo disponibilità. Nei limiti consentiti dal diritto applicabile, KiwiJuice non risponde di danni indiretti, perdita di dati o mancato guadagno derivanti dall'uso dell'app."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MyTrack é fornecida no estado em que se encontra e conforme disponibilidade. Nos limites permitidos pelo direito aplicável, a KiwiJuice não responde por danos indiretos, perda de dados nem lucros cessantes resultantes da utilização da app."
          }
        }
      }
    },
    "MyTrack est un carnet de trajets automatique. Vous payez pour enregistrer de nouveaux trajets ; ce que vous avez déjà enregistré vous reste acquis. Vos données sont sur votre appareil et vous appartiennent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack ist ein automatisches Fahrtenbuch. Sie bezahlen dafür, neue Fahrten aufzuzeichnen; was Sie bereits aufgezeichnet haben, bleibt Ihnen. Ihre Daten liegen auf Ihrem Gerät und gehören Ihnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack is an automatic trip log. You pay to record new trips; what you have already recorded remains yours. Your data is on your device and belongs to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack es un cuaderno de trayectos automático. Usted paga por registrar nuevos trayectos; lo que ya ha registrado sigue siendo suyo. Sus datos están en su dispositivo y le pertenecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack est un carnet de trajets automatique. Vous payez pour enregistrer de nouveaux trajets ; ce que vous avez déjà enregistré vous reste acquis. Vos données sont sur votre appareil et vous appartiennent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack è un libretto di viaggio automatico. Paghi per registrare nuovi viaggi; ciò che hai già registrato resta tuo. I tuoi dati sono sul tuo dispositivo e ti appartengono."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MyTrack é um caderno de viagens automático. Paga para registar novas viagens; o que já registou continua a ser seu. Os seus dados estão no seu dispositivo e pertencem-lhe."
          }
        }
      }
    },
    "MyTrack est éditée et fournie par KiwiJuice, en Suisse, et distribuée par l'App Store d'Apple. Ces conditions forment le contrat entre vous et KiwiJuice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack wird von KiwiJuice in der Schweiz herausgegeben und bereitgestellt und über den App Store von Apple vertrieben. Diese Bedingungen bilden den Vertrag zwischen Ihnen und KiwiJuice."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack is published and provided by KiwiJuice, in Switzerland, and distributed through Apple's App Store. These terms form the contract between you and KiwiJuice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack está editada y proporcionada por KiwiJuice, en Suiza, y distribuida por el App Store de Apple. Estas condiciones constituyen el contrato entre usted y KiwiJuice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack est éditée et fournie par KiwiJuice, en Suisse, et distribuée par l'App Store d'Apple. Ces conditions forment le contrat entre vous et KiwiJuice."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack è pubblicata e fornita da KiwiJuice, in Svizzera, e distribuita tramite l'App Store di Apple. Queste condizioni costituiscono il contratto tra te e KiwiJuice."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MyTrack é editada e fornecida pela KiwiJuice, na Suíça, e distribuída pela App Store da Apple. Estas condições formam o contrato entre si e a KiwiJuice."
          }
        }
      }
    },
    "MyTrack est éditée par KiwiJuice, en Suisse. C'est KiwiJuice qui répond du traitement décrit ici." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack wird von KiwiJuice in der Schweiz herausgegeben. KiwiJuice ist für die hier beschriebene Bearbeitung verantwortlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack is published by KiwiJuice, in Switzerland. KiwiJuice is responsible for the processing described here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack está editada por KiwiJuice, en Suiza. KiwiJuice es responsable del tratamiento descrito aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack est éditée par KiwiJuice, en Suisse. C'est KiwiJuice qui répond du traitement décrit ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack è pubblicata da KiwiJuice, in Svizzera. KiwiJuice è responsabile del trattamento descritto qui."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MyTrack é editada pela KiwiJuice, na Suíça. É a KiwiJuice que responde pelo tratamento aqui descrito."
          }
        }
      }
    },
    "MyTrack n'est ni un conseil fiscal, ni un conseil comptable, et ses rapports ne sont pas des pièces certifiées. Si vous vous en servez pour une note de frais, une déduction ou un contrôle, vous restez seul responsable de leur exactitude et de leur conformité aux règles qui vous concernent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack ist weder eine Steuer- noch eine Buchhaltungsberatung, und seine Berichte sind keine beglaubigten Belege. Wenn Sie sie für eine Spesenabrechnung, einen Abzug oder eine Prüfung verwenden, bleiben Sie allein für ihre Richtigkeit und ihre Übereinstimmung mit den für Sie geltenden Regeln verantwortlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack is neither tax advice nor accounting advice, and its reports are not certified records. If you use them for an expense claim, a deduction or an audit, you alone remain responsible for their accuracy and for their compliance with the rules that apply to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack no es asesoramiento fiscal ni contable, y sus informes no son documentos certificados. Si los utiliza para una nota de gastos, una deducción o una inspección, usted sigue siendo el único responsable de su exactitud y de su conformidad con las normas que le afectan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack n'est ni un conseil fiscal, ni un conseil comptable, et ses rapports ne sont pas des pièces certifiées. Si vous vous en servez pour une note de frais, une déduction ou un contrôle, vous restez seul responsable de leur exactitude et de leur conformité aux règles qui vous concernent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack non è né una consulenza fiscale né una consulenza contabile, e i suoi resoconti non sono documenti certificati. Se li usi per una nota spese, una deduzione o un controllo, resti l'unico responsabile della loro esattezza e della loro conformità alle regole che ti riguardano."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MyTrack não é aconselhamento fiscal nem contabilístico, e os seus relatórios não são documentos certificados. Se os utilizar para uma nota de despesas, uma dedução ou uma inspeção, continua a ser o único responsável pela sua exatidão e pela sua conformidade com as regras que lhe dizem respeito."
          }
        }
      }
    },
    "MyTrack ne garde aucune copie de vos trajets ailleurs que sur votre appareil. Un iPhone perdu, cassé ou effacé sans sauvegarde emporte donc vos trajets avec lui : sauvegardez votre appareil si ces données comptent pour vous." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack bewahrt keine Kopie Ihrer Fahrten ausserhalb Ihres Geräts auf. Ein verlorenes, defektes oder ohne Backup gelöschtes iPhone nimmt Ihre Fahrten also mit sich: Sichern Sie Ihr Gerät, wenn Ihnen diese Daten wichtig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack keeps no copy of your trips anywhere but on your device. An iPhone lost, broken or erased without a backup therefore takes your trips with it: back up your device if this data matters to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack no guarda ninguna copia de sus trayectos fuera de su dispositivo. Un iPhone perdido, roto o borrado sin copia de seguridad se lleva por tanto sus trayectos consigo: haga copias de seguridad de su dispositivo si estos datos le importan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack ne garde aucune copie de vos trajets ailleurs que sur votre appareil. Un iPhone perdu, cassé ou effacé sans sauvegarde emporte donc vos trajets avec lui : sauvegardez votre appareil si ces données comptent pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack non conserva alcuna copia dei tuoi viaggi al di fuori del tuo dispositivo. Un iPhone perso, rotto o cancellato senza backup porta quindi via con sé i tuoi viaggi: esegui il backup del dispositivo se questi dati contano per te."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MyTrack não guarda qualquer cópia das suas viagens fora do seu dispositivo. Um iPhone perdido, partido ou apagado sem cópia de segurança leva, portanto, as suas viagens consigo: faça cópias de segurança do dispositivo se estes dados lhe importam."
          }
        }
      }
    },
    "MyTrack s'adresse à des conducteurs. L'app n'est pas destinée aux enfants et ne recueille sciemment aucune donnée les concernant." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack richtet sich an Fahrerinnen und Fahrer. Die App ist nicht für Kinder bestimmt und erhebt wissentlich keine Daten über sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack is for drivers. The app is not intended for children and knowingly collects no data about them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack se dirige a conductores. La app no está destinada a menores y no recoge conscientemente ningún dato sobre ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack s'adresse à des conducteurs. L'app n'est pas destinée aux enfants et ne recueille sciemment aucune donnée les concernant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack si rivolge a chi guida. L'app non è destinata ai minori e non raccoglie consapevolmente alcun dato che li riguardi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MyTrack destina-se a condutores. A app não se dirige a crianças e não recolhe conscientemente quaisquer dados que lhes digam respeito."
          }
        }
      }
    },
    "MyTrack se paie de trois façons : un abonnement mensuel, un abonnement annuel, ou un achat unique qui ouvre l'accès définitivement. Les prix sont affichés dans l'app, dans votre devise, avant tout paiement." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack lässt sich auf drei Arten bezahlen: als Monatsabo, als Jahresabo oder als Einmalkauf, der den Zugang dauerhaft freischaltet. Die Preise werden vor jeder Zahlung in der App in Ihrer Währung angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack can be paid for in three ways: a monthly subscription, an annual subscription, or a one-time purchase that unlocks access for good. Prices are shown in the app, in your currency, before any payment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack se paga de tres formas: una suscripción mensual, una suscripción anual o una compra única que abre el acceso de forma definitiva. Los precios se muestran en la app, en su moneda, antes de cualquier pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack se paie de trois façons : un abonnement mensuel, un abonnement annuel, ou un achat unique qui ouvre l'accès définitivement. Les prix sont affichés dans l'app, dans votre devise, avant tout paiement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyTrack si paga in tre modi: un abbonamento mensile, un abbonamento annuale o un acquisto singolo che apre l'accesso in via definitiva. I prezzi sono mostrati nell'app, nella tua valuta, prima di qualsiasi pagamento."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MyTrack paga-se de três formas: uma subscrição mensal, uma subscrição anual ou uma compra única que abre o acesso definitivamente. Os preços são apresentados na app, na sua moeda, antes de qualquer pagamento."
          }
        }
      }
    },
    "Ne photographiez que ce que vous avez le droit de photographier, et n'envoyez rien d'illicite. Le service de photo est plafonné à quelques images par jour et peut être interrompu : l'app reste utilisable sans lui." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografieren Sie nur, was Sie fotografieren dürfen, und senden Sie nichts Rechtswidriges. Der Fotodienst ist auf einige Bilder pro Tag begrenzt und kann eingestellt werden: Die App bleibt auch ohne ihn nutzbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photograph only what you are entitled to photograph, and send nothing unlawful. The photo service is capped at a few images a day and may be discontinued: the app remains usable without it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografíe únicamente lo que tenga derecho a fotografiar y no envíe nada ilícito. El servicio de fotos está limitado a unas pocas imágenes al día y puede interrumpirse: la app sigue siendo utilizable sin él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne photographiez que ce que vous avez le droit de photographier, et n'envoyez rien d'illicite. Le service de photo est plafonné à quelques images par jour et peut être interrompu : l'app reste utilisable sans lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografa solo ciò che hai il diritto di fotografare e non inviare nulla di illecito. Il servizio foto è limitato a poche immagini al giorno e può essere interrotto: l'app resta utilizzabile senza di esso."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografe apenas o que tem o direito de fotografar e não envie nada ilícito. O serviço de fotografia está limitado a algumas imagens por dia e pode ser interrompido: a app continua utilizável sem ele."
          }
        }
      }
    },
    "Nous écrire" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreiben Sie uns"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write to us"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escríbanos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous écrire"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scriverci"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva-nos"
          }
        }
      }
    },
    "OpenAI traite la photo aux États-Unis pour produire l'image et, selon la politique de son interface de programmation, peut la conserver un temps limité à des fins de sécurité, sans s'en servir pour entraîner ses modèles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI verarbeitet das Foto in den Vereinigten Staaten, um das Bild zu erzeugen, und kann es gemäss den Richtlinien seiner Programmierschnittstelle für begrenzte Zeit zu Sicherheitszwecken aufbewahren, ohne es zum Training seiner Modelle zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI processes the photo in the United States to produce the image and, under its programming interface policy, may retain it for a limited time for safety purposes, without using it to train its models."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI trata la foto en Estados Unidos para producir la imagen y, según la política de su interfaz de programación, puede conservarla un tiempo limitado con fines de seguridad, sin utilizarla para entrenar sus modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI traite la photo aux États-Unis pour produire l'image et, selon la politique de son interface de programmation, peut la conserver un temps limité à des fins de sécurité, sans s'en servir pour entraîner ses modèles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI tratta la foto negli Stati Uniti per produrre l'immagine e, secondo la politica della sua interfaccia di programmazione, può conservarla per un tempo limitato a fini di sicurezza, senza usarla per addestrare i propri modelli."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A OpenAI trata a fotografia nos Estados Unidos para produzir a imagem e, segundo a política da sua interface de programação, pode conservá-la por um tempo limitado para fins de segurança, sem a usar para treinar os seus modelos."
          }
        }
      }
    },
    "Pas de compte, pas de mot de passe, pas d'identifiant publicitaire. Aucun outil de mesure d'audience, aucun kit tiers, aucune trace envoyée à quiconque lorsque vous ouvrez l'app ou appuyez sur un bouton." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, kein Passwort, keine Werbekennung. Keine Analysewerkzeuge, keine Fremdbibliotheken, keine Spur, die an irgendjemanden gesendet wird, wenn Sie die App öffnen oder eine Taste drücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account, no password, no advertising identifier. No analytics tools, no third-party kits, no trace sent to anyone when you open the app or tap a button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni cuenta, ni contraseña, ni identificador publicitario. Ninguna herramienta de analítica, ningún kit de terceros, ningún rastro enviado a nadie cuando abre la app o pulsa un botón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de compte, pas de mot de passe, pas d'identifiant publicitaire. Aucun outil de mesure d'audience, aucun kit tiers, aucune trace envoyée à quiconque lorsque vous ouvrez l'app ou appuyez sur un bouton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account, nessuna password, nessun identificativo pubblicitario. Nessuno strumento di analisi, nessun kit di terze parti, nessuna traccia inviata a chicchessia quando apri l'app o premi un pulsante."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, sem palavra-passe, sem identificador publicitário. Nenhuma ferramenta de medição de audiência, nenhum kit de terceiros, nenhum rasto enviado a quem quer que seja quando abre a app ou toca num botão."
          }
        }
      }
    },
    "Payer ouvre l'enregistrement de nouveaux trajets. Si votre accès prend fin, vos trajets, véhicules et rapports déjà enregistrés restent consultables et exportables." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zahlung schaltet das Aufzeichnen neuer Fahrten frei. Endet Ihr Zugang, bleiben Ihre bereits aufgezeichneten Fahrten, Fahrzeuge und Berichte einsehbar und exportierbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paying unlocks the recording of new trips. If your access ends, the trips, vehicles and reports you have already recorded remain viewable and exportable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar habilita el registro de nuevos trayectos. Si su acceso termina, los trayectos, vehículos e informes ya registrados siguen siendo consultables y exportables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payer ouvre l'enregistrement de nouveaux trajets. Si votre accès prend fin, vos trajets, véhicules et rapports déjà enregistrés restent consultables et exportables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagare apre la registrazione di nuovi viaggi. Se il tuo accesso termina, i viaggi, i veicoli e i resoconti già registrati restano consultabili ed esportabili."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar abre o registo de novas viagens. Se o seu acesso terminar, as viagens, veículos e relatórios já registados continuam consultáveis e exportáveis."
          }
        }
      }
    },
    "Pendant un trajet, MyTrack relève votre position pour tracer l'itinéraire et calculer la distance. Ces points sont écrits dans la base locale et n'en sortent pas." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während einer Fahrt erfasst MyTrack Ihren Standort, um die Route zu zeichnen und die Entfernung zu berechnen. Diese Punkte werden in die lokale Datenbank geschrieben und verlassen sie nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During a trip, MyTrack records your location to draw the route and compute the distance. Those points are written to the local database and never leave it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante un trayecto, MyTrack registra su ubicación para trazar el itinerario y calcular la distancia. Esos puntos se escriben en la base local y no salen de ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant un trajet, MyTrack relève votre position pour tracer l'itinéraire et calculer la distance. Ces points sont écrits dans la base locale et n'en sortent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante un viaggio, MyTrack rileva la tua posizione per tracciare l'itinerario e calcolare la distanza. Questi punti vengono scritti nell'archivio locale e non ne escono."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante uma viagem, a MyTrack regista a sua localização para traçar o itinerário e calcular a distância. Esses pontos são escritos na base local e não saem dela."
          }
        }
      }
    },
    "Photographiez votre voiture, pas les gens autour d'elle. Et si vous préférez ne rien envoyer, ne prenez pas de photo : l'app fonctionne très bien avec le dessin de voiture par défaut." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografieren Sie Ihr Auto, nicht die Menschen darum herum. Und wenn Sie lieber nichts senden möchten, machen Sie einfach kein Foto: Die App funktioniert bestens mit der voreingestellten Autozeichnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photograph your car, not the people around it. And if you would rather send nothing at all, simply take no photo: the app works perfectly well with the default car drawing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografíe su coche, no a la gente que hay alrededor. Y si prefiere no enviar nada, no tome ninguna foto: la app funciona perfectamente con el dibujo de coche predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photographiez votre voiture, pas les gens autour d'elle. Et si vous préférez ne rien envoyer, ne prenez pas de photo : l'app fonctionne très bien avec le dessin de voiture par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografa la tua auto, non le persone intorno. E se preferisci non inviare nulla, non scattare alcuna foto: l'app funziona benissimo con il disegno d'auto predefinito."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografe o seu carro, não as pessoas à volta. E se preferir não enviar nada, não tire fotografia alguma: a app funciona muito bem com o desenho de carro predefinido."
          }
        }
      }
    },
    "Pour toute question sur ce texte ou sur vos données, écrivez-nous." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Fragen zu diesem Text oder zu Ihren Daten schreiben Sie uns."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For any question about this text or about your data, write to us."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cualquier duda sobre este texto o sobre sus datos, escríbanos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour toute question sur ce texte ou sur vos données, écrivez-nous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per qualsiasi domanda su questo testo o sui tuoi dati, scrivici."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para qualquer questão sobre este texto ou sobre os seus dados, escreva-nos."
          }
        }
      }
    },
    "Pour toute question sur ces conditions, écrivez-nous." : {
      "localizations" : {
