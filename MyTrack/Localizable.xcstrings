    "Ces trajets ne figurent plus dans la liste : celui-ci les représente. Les séparer les y ramène tels qu'ils étaient." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Fahrten erscheinen nicht mehr in der Liste: Diese hier steht für sie. Beim Trennen kehren sie unverändert zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These trips no longer appear in the list: this one stands for them. Separating them brings them back just as they were."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos viajes ya no aparecen en la lista: este los representa. Al separarlos vuelven tal como estaban."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces trajets ne figurent plus dans la liste : celui-ci les représente. Les séparer les y ramène tels qu'ils étaient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi viaggi non compaiono più nell'elenco: è questo a rappresentarli. Separandoli tornano com'erano."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas viagens já não aparecem na lista: esta representa-as. Ao separá-las, voltam tal como estavam."
          }
        }
      }
    },
