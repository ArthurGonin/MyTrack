    "L'enregistrement des trajets nécessite un abonnement actif. Vos trajets et rapports déjà enregistrés restent accessibles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Aufzeichnen von Fahrten setzt ein aktives Abo voraus. Bereits gespeicherte Fahrten und Berichte bleiben verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording trips requires an active subscription. The trips and reports you've already saved remain available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar viajes requiere una suscripción activa. Los viajes e informes que ya ha guardado siguen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement des trajets nécessite un abonnement actif. Vos trajets et rapports déjà enregistrés restent accessibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per registrare i viaggi serve un abbonamento attivo. I viaggi e i rapporti già salvati restano accessibili."
          }
        },
        "pt" : {
