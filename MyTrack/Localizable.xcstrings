        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando MyTrack detecta un viaje, ¿quieres confirmarlo antes de que se guarde, o prefieres que se acepte automáticamente?"
          }
        },
        "fr" : {
          "stringUnit" : {
